@model personapi_dotnet.Models.Dtos.EstudioDto
@{
    ViewData["Title"] = "Estudios / Editar";
    ViewData["Subtitle"] = "Administración de registros · Estudios";
}

<h2>Editar estudios</h2>
<form asp-route="default" asp-route-controller="Estudios" asp-route-action="Edit" asp-route-originalIdProf="@Model.IdProf" asp-route-originalCcPer="@Model.CcPer" method="post" class="record-form">
    <div asp-validation-summary="All" role="alert"></div>
    <partial name="_Fields" model="Model" view-data="ViewData" />
    <div class="form-actions">
        <button type="submit" class="button button-wide">Guardar cambios</button>
        <a class="back-link" asp-route="default" asp-route-controller="Estudios" asp-route-action="Index">Cancelar · Volver al listado</a>
    </div>
</form>
@section Scripts { <partial name="_MvcValidationScriptsPartial" /> }
