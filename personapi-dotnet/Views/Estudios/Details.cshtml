@model personapi_dotnet.Models.Dtos.EstudioDto
@{
    ViewData["Title"] = "Estudios / Detalles";
    ViewData["Subtitle"] = "Administración de registros · Estudios";
}

<h2>Detalles del registro</h2>
<div class="detail-record">
    <partial name="_Details" model="Model" />
    <div class="form-actions">
        <a class="button" asp-route="default" asp-route-controller="Estudios" asp-route-action="Edit" asp-route-idProf="@Model.IdProf" asp-route-ccPer="@Model.CcPer">Editar</a>
        <a class="back-link" asp-route="default" asp-route-controller="Estudios" asp-route-action="Index">Volver al listado</a>
    </div>
</div>
