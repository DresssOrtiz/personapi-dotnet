@model IEnumerable<personapi_dotnet.Models.Entities.Estudio>
@{
    ViewData["Title"] = "Estudios / Listado";
    ViewData["Subtitle"] = "Administración de registros · Estudios";
}

<div class="toolbar">
    <h2>Listado de estudios</h2>
    <a class="button button-wide" asp-route="default" asp-route-controller="Estudios" asp-route-action="Create">+ Nuevo registro</a>
</div>
<div class="table-scroll">
<table>
    <caption class="sr-only">Registros de estudios</caption>
    <thead><tr><th scope="col">Persona</th><th scope="col">Profesión</th><th scope="col">Fecha</th><th scope="col">Universidad</th><th scope="col">Acciones</th></tr></thead>
    <tbody>
    @foreach (var item in Model)
    {
        <tr>
            <td>@( ((IReadOnlyDictionary<int, string>)ViewBag.Personas).GetValueOrDefault(item.CcPer, item.CcPer.ToString()) )</td>
            <td>@( ((IReadOnlyDictionary<int, string>)ViewBag.Profesiones).GetValueOrDefault(item.IdProf, item.IdProf.ToString()) )</td>
            <td>@(item.Fecha?.ToString("yyyy-MM-dd") ?? "—")</td>
            <td>@(item.Univer ?? "—")</td>
            <td class="row-actions">
                <a asp-route="default" asp-route-controller="Estudios" asp-route-action="Details" asp-route-idProf="@item.IdProf" asp-route-ccPer="@item.CcPer" aria-label="Ver registro">Ver</a> ·
                <a asp-route="default" asp-route-controller="Estudios" asp-route-action="Edit" asp-route-idProf="@item.IdProf" asp-route-ccPer="@item.CcPer" aria-label="Editar registro">Editar</a> ·
                <a class="delete-link" asp-route="default" asp-route-controller="Estudios" asp-route-action="Delete" asp-route-idProf="@item.IdProf" asp-route-ccPer="@item.CcPer" aria-label="Eliminar registro">Eliminar</a>
            </td>
        </tr>
    }
    @if (!Model.Any())
    {
        <tr><td class="empty" colspan="5">No hay registros. Puedes crear el primero con «Nuevo registro».</td></tr>
    }
    </tbody>
</table>
</div>
<p class="table-note">Acciones por registro: Ver · Editar · Eliminar</p>
