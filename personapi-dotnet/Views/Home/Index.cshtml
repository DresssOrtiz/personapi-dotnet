@{
    ViewData["Title"] = "Panel principal";
    ViewData["Subtitle"] = "Accede a los módulos de administración";
    var modules = new[] { ("Personas", "Personas"), ("Telefonos", "Teléfonos"), ("Profesiones", "Profesiones"), ("Estudios", "Estudios") };
}
<h2 class="home-title">Módulos del sistema</h2>
<div class="module-grid">
    @foreach (var module in modules)
    {
        <a class="module-card" asp-route-controller="@module.Item1" asp-route="default" asp-route-action="Index">
            <h3>@module.Item2</h3>
            <p>Ver y gestionar registros</p>
        </a>
    }
</div>
