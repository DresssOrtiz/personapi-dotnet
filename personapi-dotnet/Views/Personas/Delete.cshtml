@model personapi_dotnet.Models.Dtos.PersonaDto
@{
    ViewData["Title"] = "Personas / Eliminar";
    ViewData["Subtitle"] = "Administración de registros · Personas";
}

<h2>Eliminar registro de personas</h2>
<div asp-validation-summary="All" role="alert"></div>
<div class="confirmation">
    <h3>¿Confirmas la eliminación de este registro?</h3>
    <p>Esta acción podría estar restringida por registros relacionados en la base de datos.</p>
    <p class="record-identity">Cédula (cc): @Model.Cc · @Model.Nombre @Model.Apellido</p>
</div>
<form asp-route="default" asp-route-controller="Personas" asp-route-action="Delete" asp-route-originalCc="@Model.Cc" method="post" class="delete-form">
    <div class="form-actions">
        <button class="button button-danger" type="submit">Sí, eliminar</button>
        <a class="back-link" asp-route="default" asp-route-controller="Personas" asp-route-action="Index">Cancelar · Volver al listado</a>
    </div>
</form>
