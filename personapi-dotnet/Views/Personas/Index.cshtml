@model IEnumerable<personapi_dotnet.Models.Entities.Persona>
@{
    ViewData["Title"] = "Personas / Listado";
    ViewData["Subtitle"] = "Administración de registros · Personas";
}

<div class="toolbar">
    <h2>Listado de personas</h2>
    <a class="button button-wide" asp-route="default" asp-route-controller="Personas" asp-route-action="Create">+ Nuevo registro</a>
</div>
<div class="table-scroll">
<table>
    <caption class="sr-only">Registros de personas</caption>
    <thead><tr><th scope="col">Cédula</th><th scope="col">Nombre</th><th scope="col">Apellido</th><th scope="col">Género</th><th scope="col">Edad</th><th scope="col">Acciones</th></tr></thead>
    <tbody>
    @foreach (var item in Model)
    {
        <tr>
            <td>@item.Cc</td>
            <td>@item.Nombre</td>
            <td>@item.Apellido</td>
            <td>@item.Genero</td>
            <td>@(item.Edad?.ToString() ?? "—")</td>
            <td class="row-actions">
                <a asp-route="default" asp-route-controller="Personas" asp-route-action="Details" asp-route-cc="@item.Cc" aria-label="Ver registro">Ver</a> ·
                <a asp-route="default" asp-route-controller="Personas" asp-route-action="Edit" asp-route-cc="@item.Cc" aria-label="Editar registro">Editar</a> ·
                <a class="delete-link" asp-route="default" asp-route-controller="Personas" asp-route-action="Delete" asp-route-cc="@item.Cc" aria-label="Eliminar registro">Eliminar</a>
            </td>
        </tr>
    }
    @if (!Model.Any())
    {
        <tr><td class="empty" colspan="6">No hay registros. Puedes crear el primero con «Nuevo registro».</td></tr>
    }
    </tbody>
</table>
</div>
<p class="table-note">Acciones por registro: Ver · Editar · Eliminar</p>
