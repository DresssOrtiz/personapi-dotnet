@model personapi_dotnet.Models.Dtos.PersonaDto
@{
    ViewData["Title"] = "Personas / Editar";
    ViewData["Subtitle"] = "Administración de registros · Personas";
}

<h2>Editar persona</h2>
<form asp-route="default" asp-route-controller="Personas" asp-route-action="Edit" asp-route-originalCc="@Model.Cc" method="post" class="record-form">
    <div asp-validation-summary="All" role="alert"></div>
    <partial name="_Fields" model="Model" view-data="ViewData" />
    <div class="form-actions">
        <button type="submit" class="button button-wide">Guardar cambios</button>
        <a class="back-link" asp-route="default" asp-route-controller="Personas" asp-route-action="Index">Cancelar · Volver al listado</a>
    </div>
</form>
@section Scripts { <partial name="_MvcValidationScriptsPartial" /> }
