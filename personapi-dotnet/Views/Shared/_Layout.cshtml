@{
    var current = ViewContext.RouteData.Values["controller"]?.ToString() ?? "Home";
    var modules = new[] { ("Home", "Inicio"), ("Personas", "Personas"), ("Telefonos", "Teléfonos"), ("Profesiones", "Profesiones"), ("Estudios", "Estudios") };
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] · Gestión de personas</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <a class="skip-link" href="#contenido">Ir al contenido</a>
    <aside class="sidebar">
        <a class="brand" asp-route-controller="Home" asp-route="default" asp-route-action="Index"><strong>GESTIÓN</strong><span>DE PERSONAS</span></a>
        <nav aria-label="Navegación principal">
            @foreach (var module in modules)
            {
                <a asp-route-controller="@module.Item1" asp-route="default" asp-route-action="Index" class="@(current == module.Item1 ? "active" : "")" aria-current="@(current == module.Item1 ? "page" : null)">@module.Item2</a>
            }
        </nav>
    </aside>
    <main id="contenido" class="workspace">
        <header class="page-heading">
            <h1>@ViewData["Title"]</h1>
            <p>@(ViewData["Subtitle"] ?? "Administración de registros")</p>
        </header>
        <section class="surface">
            @if (TempData["Success"] is string success)
            {
                <p class="notice success" role="status">@success</p>
            }
            @RenderBody()
        </section>
    </main>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
