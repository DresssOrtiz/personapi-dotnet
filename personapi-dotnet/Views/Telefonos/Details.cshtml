@model personapi_dotnet.Models.Dtos.TelefonoDto
@{
    ViewData["Title"] = "Teléfonos / Detalles";
    ViewData["Subtitle"] = "Administración de registros · Teléfonos";
}

<h2>Detalles de teléfono</h2>
<div class="detail-record">
    <partial name="_Details" model="Model" />
    <div class="form-actions">
        <a class="button" asp-route="default" asp-route-controller="Telefonos" asp-route-action="Edit" asp-route-num="@Model.Num">Editar</a>
        <a class="back-link" asp-route="default" asp-route-controller="Telefonos" asp-route-action="Index">Volver al listado</a>
    </div>
</div>
