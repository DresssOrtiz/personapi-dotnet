@model personapi_dotnet.Models.Dtos.TelefonoDto
@{
    ViewData["Title"] = "Teléfonos / Crear";
    ViewData["Subtitle"] = "Administración de registros · Teléfonos";
}

<h2>Registrar teléfono</h2>
<form asp-route="default" asp-route-controller="Telefonos" asp-route-action="Create"  method="post" class="record-form">
    <div asp-validation-summary="All" role="alert"></div>
    <partial name="_Fields" model="Model" view-data="ViewData" />
    <div class="form-actions">
        <button type="submit" class="button button-wide">Guardar registro</button>
        <a class="back-link" asp-route="default" asp-route-controller="Telefonos" asp-route-action="Index">Cancelar · Volver al listado</a>
    </div>
</form>
@section Scripts { <partial name="_MvcValidationScriptsPartial" /> }
